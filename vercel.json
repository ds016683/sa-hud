{
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/close",
      "schedule": "5 5 * * *"
    },
    {
      "path": "/api/pulse",
      "schedule": "12,42 * * * *"
    },
    {
      "path": "/api/slack-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/clock-watch",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/consent-watch",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/lunch-sweep",
      "schedule": "7 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "/api/share?s=:slug"
    },
    {
      "source": "/lunch/:slug",
      "destination": "/api/lunch?slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/apnc",
      "destination": "/speeches/apnc-fall-2026-not-scared-prepared/",
      "permanent": false
    }
  ]
}
