{
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/close",
      "schedule": "5 5 * * *"
    },
    {
      "path": "/api/pulse",
      "schedule": "12,42 * * * *"
    },
    {
      "path": "/api/slack-sync",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "/api/share?s=:slug"
    }
  ]
}
